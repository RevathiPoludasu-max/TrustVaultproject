# Environment Configuration Template
# Copy to .env and fill in real secrets before starting the application.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=TrustVault
APP_VERSION=0.1.0
DEBUG=false
TESTING=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://trustvault_app:CHANGE_ME@localhost:5432/trustvault

# ---------------------------------------------------------------------------
# Authentication Secrets
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET=GENERATE_A_64_CHAR_RANDOM_HEX_STRING_HERE
STREAM_SECRET=GENERATE_A_DIFFERENT_64_CHAR_RANDOM_HEX_STRING_HERE
AUDIT_HMAC_KEY=GENERATE_A_THIRD_64_CHAR_RANDOM_HEX_STRING_HERE

# ---------------------------------------------------------------------------
# Token TTLs
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Hard max: 30 seconds (security policy TV-SEC-002)
STREAM_TOKEN_TTL_SECONDS=25

# ---------------------------------------------------------------------------
# Redis (stream token single-use invalidation)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/trustvault/documents
# For S3: STORAGE_BACKEND=s3, STORAGE_S3_BUCKET=your-bucket-name
# STORAGE_ENCRYPTION_KEY=GENERATE_32_BYTE_AES_KEY_HEX

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DOWNLOAD_PER_MINUTE=30

# ---------------------------------------------------------------------------
# CORS (comma-separated origins — empty = no cross-origin access)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=https://app.trustvault.io,https://admin.trustvault.io
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Security Headers
# ---------------------------------------------------------------------------
SECURE_HEADERS=true

