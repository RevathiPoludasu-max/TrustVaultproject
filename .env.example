# =============================================================================
# TrustVault — Environment Variables
# Copy this file to .env and fill in your production values.
# NEVER commit .env to source control.
# =============================================================================

# Server port (Vercel overrides this automatically; keep 3000 for local dev)
PORT=3000

# Bind host (Vercel handles this; use 0.0.0.0 for containers / local 127.0.0.1)
HOST=0.0.0.0

# =============================================================================
# CRYPTOGRAPHIC SECRETS — CHANGE ALL THREE IN PRODUCTION
# Generate secure values with: node -e "require('crypto').randomBytes(32).toString('hex')|node -e console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# HMAC key used to seal every audit log entry (must be 32+ chars)
AUDIT_HMAC_KEY=CHANGE_ME_replace_with_32plus_char_random_secret_1

# JWT signing secret for session tokens
JWT_SECRET=CHANGE_ME_replace_with_32plus_char_random_secret_2

# HMAC key used for short-lived ephemeral stream tokens (25 s TTL)
STREAM_SECRET=CHANGE_ME_replace_with_32plus_char_random_secret_3

