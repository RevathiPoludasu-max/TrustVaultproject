{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "server.js",
      "installCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/admin/dashboard",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/owner/dashboard",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/viewer/dashboard",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "app"
      }
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
